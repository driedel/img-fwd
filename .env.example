# Comma-separated list of allowed origin domains. If empty, all origins are accepted (not recommended in production).
ALLOWED_ORIGINS=cdn.examplesite.com

# Port the proxy listens on (default: 8888)
PORT=8888

# Overrides automatic origin URL reconstruction (optional)
SOURCE_BASE_URL=

# External Docker network to join (used with docker/docker-compose.local.yml)
EXTERNAL_NETWORK=my-project_default
